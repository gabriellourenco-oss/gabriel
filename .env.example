# Banco de dados (SQLite local — o arquivo é criado automaticamente)
DATABASE_URL="file:./dev.db"

# Senha de acesso ao painel administrativo (/admin)
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão do admin (gere uma string aleatória longa)
ADMIN_SESSION_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"
